NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public site origin used in emails and Stripe success/cancel URLs (required in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Direct Postgres (preferred for Stripe webhook payment apply)
# DATABASE_URL=postgresql://postgres:...@db....supabase.co:5432/postgres

# Service role (legacy JWT service_role) — required for some admin paths in production
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@farrarapps.com
BREVO_SENDER_NAME=FarrarApps

# Stripe (Checkout + webhook)
# STRIPE_SECRET_KEY=sk_test_...   (sk_live_... in production)
# STRIPE_WEBHOOK_SECRET=whsec_... (from Dashboard webhook or `stripe listen`)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Local webhook forward (keep running while testing payments):
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
